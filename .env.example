# Ứng dụng
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mekong_warranty

# Chỉ dùng cục bộ. Production bắt buộc khóa riêng ngẫu nhiên >=32 ký tự.
JWT_SECRET=dev-only-jwt-key-change-me-before-production-2026
JWT_EXPIRES_IN=8h

# Tài khoản demo cho prototype (không phải tài khoản thật)
DEMO_STAFF_USERNAME=nhanvien
DEMO_STAFF_PASSWORD=nhanvien123
DEMO_STAFF_NAME=Nguyễn Duy Khang
DEMO_STAFF_CENTER=1

# Log JSON ra stdout; không ghi body/query, thông tin cá nhân hoặc bí mật.
LOG_LEVEL=info

# Thời gian chờ tính bằng mili giây; /health trả 503 khi CSDL chưa sẵn sàng.
DB_SERVER_SELECTION_TIMEOUT_MS=3000
DB_CONNECT_TIMEOUT_MS=3000
DB_SOCKET_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
