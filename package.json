{
  "name": "mekong-mobile-warranty-crm",
  "version": "0.2.0",
  "private": true,
  "description": "Sprint 1 + 2 core warranty intake module for Smart CRM – Mekong Mobile (Luồng L2, Track SE)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
